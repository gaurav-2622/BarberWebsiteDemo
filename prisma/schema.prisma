generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  BARBER
  OWNER
}

enum AppointmentStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum BookingSource {
  WEBSITE
  ADMIN
  PHONE
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(3)
  image         String?
  phone         String?   @unique
  passwordHash  String?   @map("password_hash")
  role          UserRole  @default(CUSTOMER)
  slug          String?   @unique
  jobTitle      String?   @map("job_title")
  bio           String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts             Account[]
  sessions             Session[]
  authenticators       Authenticator[]
  barberServices       BarberService[]
  workingHours         WorkingHour[]
  blockedTimes         BlockedTime[]
  customerAppointments Appointment[]   @relation("CustomerAppointments")
  barberAppointments   Appointment[]   @relation("BarberAppointments")

  @@index([role, isActive])
  @@map("users")
}

model Account {
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Authenticator {
  credentialID         String  @unique @map("credential_id")
  userId               String  @map("user_id") @db.Uuid
  providerAccountId    String  @map("provider_account_id")
  credentialPublicKey  String  @map("credential_public_key")
  counter              Int
  credentialDeviceType String  @map("credential_device_type")
  credentialBackedUp   Boolean @map("credential_backed_up")
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@map("authenticators")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  description     String?  @db.Text
  category        String?
  durationMinutes Int      @map("duration_minutes")
  bufferMinutes   Int      @default(0) @map("buffer_minutes")
  priceCents      Int      @map("price_cents")
  depositCents    Int      @default(0) @map("deposit_cents")
  currency        String   @default("USD") @db.Char(3)
  imageUrl        String?  @map("image_url")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbers      BarberService[]
  appointments Appointment[]

  @@index([isActive, sortOrder])
  @@map("services")
}

model BarberService {
  barberId              String   @map("barber_id") @db.Uuid
  serviceId             String   @map("service_id") @db.Uuid
  customPriceCents      Int?     @map("custom_price_cents")
  customDurationMinutes Int?     @map("custom_duration_minutes")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  barber  User    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId, isActive])
  @@map("barber_services")
}

model Appointment {
  id                      String            @id @default(uuid()) @db.Uuid
  confirmationCode        String            @unique @map("confirmation_code")
  managementToken         String            @unique @map("management_token")
  customerId              String?           @map("customer_id") @db.Uuid
  barberId                String            @map("barber_id") @db.Uuid
  serviceId               String            @map("service_id") @db.Uuid
  customerName            String            @map("customer_name")
  customerEmail           String            @map("customer_email")
  customerPhone           String            @map("customer_phone")
  serviceName             String            @map("service_name")
  serviceDurationMinutes  Int               @map("service_duration_minutes")
  serviceBufferMinutes    Int               @default(0) @map("service_buffer_minutes")
  startsAt                DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime          @map("ends_at") @db.Timestamptz(3)
  timeZone                String            @default("America/New_York") @map("time_zone")
  status                  AppointmentStatus @default(PENDING_PAYMENT)
  bookingSource           BookingSource     @default(WEBSITE) @map("booking_source")
  priceCents              Int               @map("price_cents")
  depositCents            Int               @default(0) @map("deposit_cents")
  amountPaidCents         Int               @default(0) @map("amount_paid_cents")
  currency                String            @default("USD") @db.Char(3)
  paymentStatus           PaymentStatus     @default(PENDING) @map("payment_status")
  stripeCheckoutSessionId String?           @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?           @unique @map("stripe_payment_intent_id")
  customerNotes           String?           @map("customer_notes") @db.Text
  internalNotes           String?           @map("internal_notes") @db.Text
  cancellationReason      String?           @map("cancellation_reason") @db.Text
  cancelledAt             DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  reminderSentAt          DateTime?         @map("reminder_sent_at") @db.Timestamptz(3)
  reminder24hSentAt       DateTime?         @map("reminder_24h_sent_at") @db.Timestamptz(3)
  reminder2hSentAt        DateTime?         @map("reminder_2h_sent_at") @db.Timestamptz(3)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer User?   @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: SetNull)
  barber   User    @relation("BarberAppointments", fields: [barberId], references: [id], onDelete: Restrict)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([barberId, startsAt, endsAt])
  @@index([status, startsAt])
  @@index([customerId, startsAt])
  @@index([customerEmail, startsAt])
  @@index([status, startsAt, reminder24hSentAt])
  @@index([status, startsAt, reminder2hSentAt])
  @@map("appointments")
}

model ShopSettings {
  id                       String   @id @default("default")
  businessName             String   @map("business_name")
  tagline                  String?
  description              String?  @db.Text
  email                    String
  phone                    String
  addressLine1             String   @map("address_line_1")
  addressLine2             String?  @map("address_line_2")
  city                     String
  state                    String
  postalCode               String   @map("postal_code")
  country                  String   @default("US")
  timeZone                 String   @default("America/New_York") @map("time_zone")
  currency                 String   @default("USD") @db.Char(3)
  bookingWindowDays        Int      @default(60) @map("booking_window_days")
  minimumLeadTimeMinutes   Int      @default(120) @map("minimum_lead_time_minutes")
  cancellationWindowHours  Int      @default(24) @map("cancellation_window_hours")
  slotIntervalMinutes      Int      @default(15) @map("slot_interval_minutes")
  defaultDepositCents      Int      @default(0) @map("default_deposit_cents")
  bookingEnabled           Boolean  @default(true) @map("booking_enabled")
  onlinePaymentsEnabled    Boolean  @default(false) @map("online_payments_enabled")
  confirmationEmailEnabled Boolean  @default(true) @map("confirmation_email_enabled")
  reminderEmailEnabled     Boolean  @default(true) @map("reminder_email_enabled")
  reminderLeadHours        Int      @default(24) @map("reminder_lead_hours")
  instagramUrl             String?  @map("instagram_url")
  facebookUrl              String?  @map("facebook_url")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("shop_settings")
}

model WorkingHour {
  id          String   @id @default(uuid()) @db.Uuid
  barberId    String   @map("barber_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week")
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  barber User @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@index([dayOfWeek, isActive])
  @@map("working_hours")
}

model BlockedTime {
  id        String   @id @default(uuid()) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  barber User @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt, endsAt])
  @@map("blocked_times")
}
